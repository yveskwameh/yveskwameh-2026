---
/**
 * The desktop: freely draggable icons + the windows they open.
 * No window is open on load. Windows are real HTML at build time, shown on click.
 */
import DesktopIcon from './DesktopIcon.astro';
import Window from '../windows/Window.astro';
import AboutApp from '../apps/AboutApp.astro';
import ProjectsApp from '../apps/ProjectsApp.astro';
import GameApp from '../apps/GameApp.astro';
import ColophonApp from '../apps/ColophonApp.astro';
import MailApp from '../apps/MailApp.astro';
import ServicesApp from '../apps/ServicesApp.astro';
import TestimonialsApp from '../apps/TestimonialsApp.astro';
import { desktopItems } from '../../data/desktop';
import Prints from './Prints.astro';
---
<main class="desktop" id="desktop">
  {desktopItems.map((item) => <DesktopIcon {...item} />)}
  {/* After the icons and before the windows, so it paints over the one and under the
      other with no z-index arguments. Its own file explains the rest. */}
  <Prints />

  {/* 860 like Work and the game. The bio is a 330px column and the nine photographs are
      three across beside it, and at the old 560 the wall came out too small to be worth
      showing. */}
  <Window id="about" title="About Yves" filename="about-yves.txt" width={860}><AboutApp /></Window>
  {/* Explicitly sized, unlike the other windows. The browser inside it is a two column
      layout whose panes fill their side and scroll themselves, and `height: 100%` against
      a window that sizes to its content collapses to the height of the sidebar. */}
  <Window id="projects" title="Work" filename="work.folder" width={860}><ProjectsApp /></Window>
  {/* No height prop: GameApp.astro opens this one at the full height the desktop allows,
      so the thread has the most room it can get. Wider than the 400 column it holds on
      purpose: the margins either side are the layout. */}
  <Window id="game" title="Tic Tac Toe" filename="tictactoe.app" width={860}><GameApp /></Window>
  <Window id="colophon" title="About this site" filename="readme.txt" width={520}><ColophonApp /></Window>
  {/* Anchored bottom right and slides up, like Gmail compose. See the compose variant in
      Window.astro. Sized to the shorter, wider shape a compose panel wants. 700 rather
      than 460 since direction B put a note from Yves beside the fields: 268 for the note
      leaves the fields 432, which is close to the 460 the whole window used to be. */}
  <Window id="contact" title="Send Yves a message" filename="new-message.eml" width={700} height={430} variant="compose"><MailApp /></Window>
  {/* 640 because the disclosure list is one column of prose and six rows, and wider than
      this just makes the lines harder to read. */}
  <Window id="services" title="Services" filename="services.prefs" width={640}><ServicesApp /></Window>
  {/* 760 to fit two quote cards across. One column below 640, handled in the app. The id
      is testimonials rather than feedback because that is what data/desktop.ts opens. */}
  <Window id="testimonials" title="Feedback" filename="feedback.txt" width={760}><TestimonialsApp /></Window>

  {/* The unmute notice. One line, once, and only to somebody who is missing something.

      Every condition is in the selector at the bottom of this file rather than in a
      script: sound off, lock screen already dismissed, not already waved away. The 45
      second wait is the animation's delay, and `both` holds the first keyframe until it
      elapses, which is what keeps the pill hidden and unclickable while it waits.

      "Turn on" is a real button because the speaker is a <summary> now and cannot be
      driven by a <label for>. scripts/panel.ts picks it up, and by the time this shows
      it has been loaded since the first pointer move. */}
  <div class="notice" role="status">
    {/* Inside the notice, not beside it. Clicking a <label for> makes the browser forward
        a second click to the input it names, and the dismiss below is a click-outside
        rule: with the checkbox outside the pill, that forwarded click read as a click on
        the desktop and threw away whatever window was open. The selector that hides the
        notice is :has() on body, so this can sit anywhere. */}
    <input class="notice__x" id="notice-x" type="checkbox" hidden />
    <span class="notice__glyph" aria-hidden="true"></span>
    <span class="notice__text">Sound is off</span>
    <button class="notice__go" type="button" data-vol="60">Turn on</button>
    <label class="notice__close" for="notice-x" tabindex="0" role="button" aria-label="Dismiss">&times;</label>
  </div>

  {/* Pushes the desktop back behind whatever is open. Still pointer-events: none, even
      though window-manager.ts now dismisses on a click outside: swallowing the click here
      instead would cost the icons their double click to open, and windows their drag. */}
  <div class="scrim" aria-hidden="true"></div>
</main>

{/* Live cursors. Everyone with the site open sees everyone else move, and hovering
    somebody's name chip offers them a reaction. All build-time markup, per rule 3: the
    only thing scripts/presence.ts does is position clones of the template and set text.

    Fixed rather than inside .desktop so a cursor can travel over the menu bar and the
    dock too, which is where people actually point at things. */}
<div class="peers" id="peers" aria-hidden="true"></div>
<div class="me" id="me" hidden aria-hidden="true"><button class="chip" id="me-chip" type="button">you</button></div>
<input class="chip chip--edit" id="me-edit" hidden maxlength="24" aria-label="Your name" />
<div class="react" id="react" hidden role="menu" aria-label="Send a reaction">
  {['👋', '💗', '😂', '⭐', '👀', '🎉', '🥂'].map((e) => (
    <button type="button" role="menuitem" data-e={e} aria-label={`React ${e}`}>{e}</button>
  ))}
</div>
<template id="peer-tpl"><div class="peer"><i class="peer__arrow"></i><span class="chip peer__chip"></span></div></template>

{/* Right-click menus. Real HTML at build time like the windows, so their wording rides in
    the gzipped page rather than in the JS budget. scripts/context.ts shows whichever one
    matches what was clicked. Items carrying data-open or data-action need nothing from it,
    because the listeners for those already exist. */}
<div class="ctx" id="ctx-desktop" role="menu" hidden>
  <button role="menuitem" type="button" data-ctx="refresh">Refresh</button>
  <button role="menuitem" type="button" data-action="tidy">Clean up desktop</button>
  <hr />
  <button role="menuitem" type="button" data-open="contact">New message</button>
  <button role="menuitem" type="button" data-open="colophon">About this site</button>
</div>
<div class="ctx" id="ctx-menubar" role="menu" hidden>
  <button role="menuitem" type="button" data-action="lock">Lock desktop</button>
  <button role="menuitem" type="button" data-action="tidy">Clean up desktop</button>
  <hr />
  <button role="menuitem" type="button" data-open="contact">New message</button>
  <button role="menuitem" type="button" data-open="colophon">About this site</button>
</div>
<div class="ctx" id="ctx-icon" role="menu" hidden>
  <button role="menuitem" type="button" data-ctx="open">Open</button>
  <button role="menuitem" type="button" data-ctx="rename">Rename</button>
  <hr />
  <button role="menuitem" type="button" data-ctx="reset">Reset name</button>
</div>

<style>
  .desktop { position: fixed; inset: var(--menubar-h) 0 0 0; }
  /* Refresh blinks the icons out and back. It is the only visible sign that the desktop
     redrew, since nothing else about it changes. */
  .desktop.is-refreshing :global(.icon), .desktop.is-refreshing :global(.print) { opacity: 0; }

  /* z-index 5: above the icons, which have none, and below the windows, which start at 10
     from focusWindow. It sits inside .desktop so the dock and the menu bar stay crisp,
     which is right for system chrome. */
  .scrim {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background: rgba(10, 14, 20, .22);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    opacity: 0; transition: opacity var(--t-base) var(--ease);
  }
  /* window-manager.ts puts has-window on the body whenever anything is open. */
  :global(body.has-window) .scrim { opacity: 1; }
  /* On a phone a window is a bottom sheet, so the scrim has to reach further than it does
     on a desktop: over the dock at 800, under the menu bar at 900, which is the reach Yves
     asked for and the same one iOS gives the status bar. It needs no new geometry, because
     .desktop already spans from under the menu bar to the bottom edge.

     And it answers the pointer here, which it never does on a desktop. Without that, a tap
     where the dock is would fall through the scrim and open Images from behind the sheet.
     Swallowing it instead dismisses, because a tap on .scrim matches none of the exceptions
     in window-manager.ts and closeOthers() is already what happens. */
  @media (max-width: 640px) {
    /* Raise the whole desktop over the dock while a sheet is up, rather than the window
       alone, because the two engines disagree about this element. `.desktop` is
       position: fixed with z-index auto: Chrome leaves it out of the stacking order, so a
       window's own z-index competes with the dock directly, but iOS Safari treats every
       fixed element as a stacking context, which traps the window inside `.desktop` and
       lets the dock at 800 paint straight over the sheet. Measured on the iPhone 17
       simulator, where the dock was sitting on top of the About text.

       Lifting the layer works on both, and it makes them agree: the scrim and the window
       order themselves inside it, the menu bar at 900 still sits above the lot, and the
       dock is behind the scrim where a sheet wants it. Only while something is open, so
       the dock is a normal dock the rest of the time. */
    :global(body.has-window) .desktop { z-index: 810; }
    .scrim { z-index: 805; }
    :global(body.has-window) .scrim { pointer-events: auto; }
    /* Under the sheet, not over it. The notice is 880 so it can clear the dock on a
       desktop, and once .desktop became a stacking context above that 880 started winning
       against the sheet instead: it landed across the title bar. A sheet is modal, so the
       suggestion waits behind it and is there again when the sheet closes. Not display:
       none, which would restart its twelve second wait every time a window closed. */
    .notice { z-index: 806; }
  }
  /* And the icons stop answering the pointer while it is up. The scrim itself stays
     pointer-events: none on purpose, so a click still reaches the desktop and dismisses
     the window, but an icon underneath a blur has no business lighting up and playing a
     sound when the pointer passes over it. Taking the icons out of hit testing rather
     than the whole desktop is what keeps the dismiss working. */
  :global(body.has-window) :global(.icon), :global(body.has-window) :global(.print) { pointer-events: none; }

  .ctx {
    position: fixed; z-index: 950; min-width: 190px; padding: 6px;
    background: var(--os-menu);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    border: 1px solid var(--os-edge); border-radius: var(--r-window); box-shadow: var(--os-shadow-sm);
  }
  .ctx[hidden] { display: none; }
  .ctx button {
    all: unset; display: block; width: 100%; box-sizing: border-box;
    padding: 6px 10px; border-radius: var(--r-inner); cursor: var(--cur-hand);
    font: 12px var(--font-chrome); color: var(--os-ink);
  }
  .ctx button:hover { background: var(--os-accent); color: var(--os-on-accent); }

  /* ------------------------------------------------------------------
     Live cursors.

     Above the dock so somebody pointing at it can be seen, below the menu bar so a cursor
     never covers the clock. The layer itself never takes a click; only the name chips do,
     because hovering one is what offers a reaction, and a stranger's cursor drifting over
     a button should not stop you pressing it.
     ------------------------------------------------------------------ */
  .peers { position: fixed; inset: 0; z-index: 850; pointer-events: none; }
  .peer, .me {
    position: fixed; top: 0; left: 0; z-index: 850; pointer-events: none;
    display: flex; align-items: flex-start; gap: 2px;
    /* translate3d keeps each cursor on its own layer, so a room full of them moves without
       relaying out the page. */
    will-change: transform;
    /* Parked off screen until a script gives them a real position. Everything in this
       layer is `fixed` at 0,0 by default, which is directly under the menu bar, so
       without this any of them flashes there for a frame on the way to being placed.
       The global `[hidden]` rule in global.css handles the hidden case; this handles
       the shown-but-not-yet-positioned one. */
    transform: translate3d(-200px, -200px, 0);
  }
  .me { z-index: 851; }
  /* Repeated locally although global.css now covers every `hidden`, because the two rules
     above set `display: flex` and a reader of this file needs to see why that is safe. */
  .me[hidden], .chip--edit[hidden] { display: none; }
  /* Drawn rather than the cursor PNG, because each visitor needs their own colour and a
     bitmap cannot be tinted. */
  .peer__arrow {
    width: 13px; height: 17px; flex: none; background: currentColor;
    clip-path: polygon(0 0, 0 82%, 23% 63%, 39% 97%, 55% 89%, 40% 57%, 72% 53%);
    filter: drop-shadow(0 1px 1px rgba(0,0,0,.35));
  }
  .chip {
    all: unset; display: block; margin-top: 12px;
    padding: 3px 9px; border-radius: var(--r-pill);
    background: var(--peer, var(--os-accent)); color: #fff;
    font: 10px var(--font-chrome); letter-spacing: .02em; white-space: nowrap;
    box-shadow: 0 2px 6px rgba(0,0,0,.25);
  }
  /* Only your own chip answers the pointer, and only so you can click it to rename
     yourself. Everybody else's cursor is completely inert, which is stronger than it used
     to be: their chip used to be hoverable, which meant a stranger parking on a button
     could stop you pressing it. Hovering somebody to react to them no longer needs hit
     testing at all. presence.ts knows where every cursor is, because it put them there,
     so it compares your pointer against those positions instead. That also fixes the bug
     this all started with: your own chip rides under your pointer, so whenever you point
     at somebody it lands on top of them and swallowed the hover. */
  #me-chip { pointer-events: auto; cursor: var(--cur-hand); }
  #me-chip { opacity: .75; }
  #me-chip:hover { opacity: 1; }
  .chip--edit {
    position: fixed; z-index: 860; left: -999px; width: 130px; border: 0; text-align: center;
    background: var(--os-accent); color: var(--os-on-accent); font: 10px var(--font-chrome);
    padding: 4px 9px; border-radius: var(--r-pill);
  }
  .chip--edit:focus { outline: 2px solid #fff; outline-offset: 1px; }

  .react {
    position: fixed; z-index: 860; left: -999px; display: flex; gap: 2px; padding: 4px;
    background: var(--os-menu); border: 1px solid var(--os-edge);
    border-radius: var(--r-pill); box-shadow: var(--os-shadow-sm);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
  }
  .react[hidden] { display: none; }
  .react button {
    all: unset; width: 26px; height: 26px; display: grid; place-items: center;
    border-radius: 50%; cursor: var(--cur-hand); font-size: 15px; line-height: 1;
    transition: transform var(--t-fast), background var(--t-fast);
  }
  .react button:hover { background: var(--os-hover); transform: scale(1.25); }

  /* The reaction emoji are styled in global.css, not here. They are created by
     presence.ts rather than written in this file's markup, and Astro scopes these styles
     to the elements it can see, so a rule for them here matches nothing. That is not a
     guess: the old .pop rule lived here and never applied, which is why a reaction was a
     bare inline emoji stuck in the top corner instead of anything rising. */

  @media (prefers-reduced-motion: reduce) {
    .peer, .me { will-change: auto; }
    .pop { animation-duration: 1ms; }
  }
  /* ------------------------------------------------------------------
     The unmute notice. A pill, which is the smallest thing that still offers the action.
     ------------------------------------------------------------------ */
  .notice {
    position: fixed; z-index: 880;
    top: calc(var(--menubar-h) + var(--space-2)); right: var(--space-2);
    display: flex; align-items: center; gap: var(--space-2);
    padding: 6px 8px 6px 14px; border-radius: var(--r-pill);
    background: var(--os-menu); border: 1px solid var(--os-edge);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    box-shadow: var(--os-shadow-sm); color: var(--os-ink);
    /* Hidden, and unreachable, until the animation below is both applied and finished
       waiting. Visibility rather than display, because display cannot be animated and
       opacity alone would leave an invisible pill swallowing clicks while it waits. */
    visibility: hidden; opacity: 0;
  }
  .notice__glyph {
    width: 13px; height: 13px; flex: none; border-radius: 2px;
    background: var(--os-muted); opacity: .7;
    clip-path: polygon(0 32%, 26% 32%, 55% 0, 55% 100%, 26% 68%, 0 68%);
  }
  /* Takes the slack, so the button and the close sit at the right hand end. On a desktop
     the pill is only as wide as its contents and there is no slack to take; on a phone it
     runs the width of the screen, and without this everything bunched at the left with the
     close stranded in the middle of the pill. */
  .notice__text { flex: 1; font: 12px var(--font-chrome); }
  .notice__go {
    all: unset; padding: 7px 13px; border-radius: var(--r-pill); cursor: var(--cur-hand);
    background: var(--os-accent); color: var(--os-on-accent);
    font: 700 11px var(--font-chrome);
  }
  .notice__go:hover { background: var(--os-accent-bright); }
  .notice__go:focus-visible, .notice__close:focus-visible {
    outline: 2px solid var(--os-accent); outline-offset: 2px;
  }
  .notice__close {
    width: 22px; height: 22px; flex: none; display: grid; place-items: center;
    border-radius: 50%; cursor: var(--cur-hand); color: var(--os-muted);
    font: 15px/1 var(--font-chrome);
  }
  .notice__close:hover { background: var(--os-hover); color: var(--os-ink); }

  /* Sound off, lock screen already dismissed, and not already waved away. #lock carries
     is-open once the desktop has been entered, so the wait starts at the desktop rather
     than at the lock screen, where the visitor has only just answered this question.

     Twelve seconds, not the forty five it was. Long enough that it is not a popup landing
     on somebody who has just arrived, short enough that they are still on their first
     window when it comes, which is the moment the offer is worth anything. */
  body:not(.snd-on):has(#lock.is-open):not(:has(#notice-x:checked)) .notice {
    animation: notice-in .42s var(--ease) 12s both;
  }
  @keyframes notice-in {
    0%   { opacity: 0; transform: translateX(22px); visibility: hidden; }
    1%   { visibility: visible; }
    100% { opacity: 1; transform: none; visibility: visible; }
  }
  @media (prefers-reduced-motion: reduce) {
    @keyframes notice-in {
      0%   { opacity: 0; visibility: hidden; }
      1%   { visibility: visible; }
      100% { opacity: 1; visibility: visible; }
    }
  }
  @media (max-width: 640px) {
    .notice { left: var(--space-2); right: var(--space-2); }
  }

  .ctx hr { margin: 4px 6px; border: 0; border-top: 1px solid var(--os-hairline); }
  @media (max-width: 640px) {
    /* phone home screen: icons flow in a grid, positions from data are ignored */
    .desktop { display: grid; grid-template-columns: repeat(4, 1fr); align-content: start; gap: var(--space-4) var(--space-2); padding: var(--space-4) var(--space-2) 120px; }
    /* width: auto as well. An icon is 98px wide on a desktop, and four of those with the
       gaps and padding come to 424px, which cut the fourth column off a 393px phone.
       auto lets each one fill its column instead, 88px on that phone, and the label wraps
       inside it. Measured in headless Chrome and on the iPhone 17 simulator. */
    .desktop :global(.icon) { position: static !important; width: auto; }
  }
</style>

<script>
  import { initWindowManager, openWindow } from '../../scripts/window-manager';
  import { initActions } from '../../scripts/actions';
  import { initWarm } from '../../scripts/lazy';
  import { unlock } from '../../scripts/lock';
  initWindowManager();
  initActions();
  initWarm();

  /* A link like /#work-compass opens the Work window on that case study, which is the one
     thing a desktop of hidden windows cannot do for itself. It skips the lock screen too,
     because someone arriving at a named case study came for the work, not the game. */
  if (location.hash.startsWith('#work-')) { unlock(); openWindow('projects'); }
</script>
