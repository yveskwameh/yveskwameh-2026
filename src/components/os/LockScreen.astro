---
/**
 * The entry gate, back to the first layout: content pinned to the top and bottom edges
 * with the identity floating in the middle, and the time as large translucent type
 * rather than a card. No tiles, no dashboard.
 */
import { existsSync } from 'node:fs';
import { site } from '../../data/site';
import Icon from './Icon.astro';

// Falls back to initials if the photo is ever missing, so it never renders broken.
const hasAvatar = existsSync('public' + site.avatar);
const initials = site.name.split(' ').map((w) => w[0]).join('');
---
{/* The sound gate. A corner pill was too easy to miss, so this covers the screen and has
    to be answered before anything else on the lock screen can be touched. */}
<div id="lock-gate" class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-h" hidden>
  <div class="gate__card">
    <span class="gate__icon"><Icon name="volume-2" size={22} /></span>
    <p class="gate__eyebrow">YVES DESKTOP</p>
    <h2 class="gate__title" id="gate-h">Best with sound on</h2>
    <p class="gate__body">There is a voice line and a few small sounds. Nothing plays until you say so.</p>
    <button class="btn btn--lg" type="button" data-snd="on">Enter with sound</button>
    <button class="btn btn--secondary btn--on-dark btn--lg gate__no" type="button" data-snd="off">Continue muted</button>
  </div>
</div>

<div id="lock" class="lock" role="dialog" aria-label="Locked. Click to enter.">
  <div class="lock__top">
    <p class="lock__date" id="lock-date">---</p>
    <p class="lock__time"><span id="lock-time">--:--</span></p>
    <p class="lock__meta">{site.location} · {site.availability}</p>

    <ul class="lock__socials">
      {site.socials.map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
          <Icon name={s.glyph} size={16} />
        </a></li>
      ))}
    </ul>
  </div>

  <div class="lock__id">
    <span class="lock__face">
      {hasAvatar
        ? <img class="lock__avatar" id="lock-avatar" src={site.avatar} alt="" width="64" height="64" />
        : <span class="lock__avatar lock__avatar--fallback" id="lock-avatar" aria-hidden="true">{initials}</span>}
    </span>
    {/* The h1 for the whole desktop. It is the page's subject, it is already the most
        prominent text on it, and .lock__name sets margin and size, so making it a heading
        changes nothing visually and gives the page the one heading it was missing. */}
    <h1 class="lock__name">{site.name}</h1>
    <p class="lock__title">{site.title}</p>
    <p class="lock__status-line"><span class="lock__dot" aria-hidden="true"></span>{site.status}</p>
  </div>

  <div class="lock__bottom">
    {/* One word, because it works on every input. "Click" is wrong on a phone and "tap"
        is wrong on a desktop, and the lock glyph beside it already says what it does. */}
    <button class="lock__cta" id="lock-cta" type="button" data-unlock>
      <Icon name="lock" size={13} /><span>UNLOCK</span>
    </button>

    <p class="lock__status"><span>PREPARING DESKTOP…</span><span>READY</span></p>
  </div>
</div>

<style>
  .lock {
    position: fixed; inset: 0; z-index: 1000;
    display: grid; grid-template-rows: auto 1fr auto; justify-items: center;
    padding: 6dvh var(--space-4) 4dvh; text-align: center; color: #fff;
    background-color: var(--os-desktop);
    background-image: var(--wallpaper-wash), var(--wallpaper);
    background-position: center, center;
    background-size: cover, cover;
    background-repeat: no-repeat, no-repeat;
    transition: opacity 420ms var(--ease), transform 420ms var(--ease), visibility 0s;
  }
  .lock::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(14,28,48,.78), rgba(14,28,48,.5) 45%, rgba(14,28,48,.72));
    -webkit-backdrop-filter: blur(2px) saturate(1.1); backdrop-filter: blur(2px) saturate(1.1);
  }
  .lock__top, .lock__id, .lock__bottom { position: relative; display: grid; justify-items: center; }
  .lock__top { gap: var(--space-2); }
  .lock__id { align-content: center; gap: 3px; }
  .lock__bottom { align-content: end; gap: var(--space-4); }
  /* The one interactive thing on the screen, so it stays above the decoration. Nothing
     else here carries a z-index, so this one number is the entire stacking order. */
  .lock__cta { z-index: 5; }

  .lock__date { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: .01em; }
  .lock__time {
    margin: 0; font-size: clamp(76px, 15vw, 150px); line-height: .95; font-weight: 700;
    letter-spacing: -.03em; color: rgba(255,255,255,.55); font-variant-numeric: tabular-nums;
  }

  .lock__socials { display: flex; gap: var(--space-2); margin: var(--space-2) 0 0; padding: 0; list-style: none; }
  .lock__socials a {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; color: #fff;
    background: var(--glass); border: var(--glass-line); box-shadow: var(--glass-sheen);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    transition: background var(--t-fast);
  }

  /* Positioning context for the bubble, so it sits just above his head */
  .lock__face { position: relative; display: block; margin-bottom: var(--space-2); }
  .lock__avatar { width: 64px; height: 64px; border-radius: 50%; display: block; }
  .lock__avatar--fallback {
    display: grid; place-items: center; font-size: 21px; font-weight: 700; letter-spacing: .04em;
    background: var(--glass); border: var(--glass-line); box-shadow: var(--glass-sheen);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
  }
  .lock__name { margin: 0; font-size: 20px; font-weight: 700; }
  .lock__title { margin: 0; font-size: 11px; letter-spacing: .22em; color: rgba(255,255,255,.75); }

  /* One rule, not two. This was declared twice and the second transition shorthand was
     silently overriding the first. */
  /* Deliberately NOT `all: unset`. That reset also wipes box-shadow, and because this
     scoped rule outranks the `:focus-visible` in global.css it was cancelling the site's
     own focus ring on the one control that matters. Resetting only what needs resetting
     lets the shared ring apply, so this button focuses like everything else. */
  .lock__cta {
    appearance: none; margin: 0; cursor: var(--cur-hand); position: relative;
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: 11px 26px; border-radius: var(--r-pill);
    background-color: var(--unlock-fill);
    background-image: var(--glass);
    border: var(--glass-line); box-shadow: var(--glass-sheen);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    font: inherit; font-size: 12px; letter-spacing: .18em; color: #fff;
    text-shadow: 0 1px 2px rgba(0,0,0,.35);   /* keeps the label legible over any wallpaper */
    /* Light and shadow only, no transform. The button no longer moves, and a hover lift
       on the one control everybody has to hit buys nothing but a moving target. */
    transition: background-color var(--t-fast), box-shadow var(--t-fast), border-color var(--t-fast);
  }
  .lock__socials a:hover { background: var(--glass-hover); }
  .lock__socials a:active { background: var(--glass-press); }
  .lock__cta:hover {
    border-color: rgba(255,255,255,.55);
    box-shadow: var(--glass-sheen), 0 10px 26px -10px rgba(0,0,0,.6);
  }
  .lock__cta:active { box-shadow: var(--glass-sheen); }

  /* Pure theatre, so it belongs in CSS. Both states ship in the markup stacked in one
     grid cell and cross-fade on a delay, which drops a lookup, a timer and two strings
     out of the JS budget. */
  .lock__status {
    margin: 0; display: grid; font-size: 10px; letter-spacing: .22em; color: rgba(255,255,255,.45);
  }
  .lock__status span { grid-area: 1 / 1; animation: 1ms var(--ease) 1200ms both; }
  .lock__status span:first-child { animation-name: hide; }
  .lock__status span:last-child { opacity: 0; animation-name: show; }
  @keyframes hide { to { opacity: 0; } }
  @keyframes show { to { opacity: 1; } }

  .lock__meta { margin: 0; font-size: 11px; letter-spacing: .18em; color: rgba(255,255,255,.55); }
  .lock__status-line {
    display: inline-flex; align-items: center; gap: 7px; margin: var(--space-2) 0 0;
    font-size: 11px; color: rgba(255,255,255,.8);
  }
  .lock__dot {
    position: relative;
    width: 7px; height: 7px; border-radius: 50%; background: #35d07f;
    box-shadow: 0 0 0 3px rgba(53,208,127,.22);
  }
  /* The ring travels on a pseudo-element rather than on the dot's own box-shadow, so the
     dot stays exactly the size it is and only the ring moves. */
  .lock__dot::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    animation: ping 2.8s var(--ease) infinite;
  }
  /* Two pulses close together and then a rest, so it reads as a pulse rather than a
     metronome. The jump back to nothing at 22% is invisible because the ring has already
     faded to fully transparent by 18%. */
  @keyframes ping {
    0%        { box-shadow: 0 0 0 0 rgba(53,208,127,.55); }
    18%       { box-shadow: 0 0 0 7px rgba(53,208,127,0); }
    22%       { box-shadow: 0 0 0 0 rgba(53,208,127,.4); }
    40%, 100% { box-shadow: 0 0 0 7px rgba(53,208,127,0); }
  }
  .lock__hint {
    margin: 0; min-height: 1.2em; font-size: 11px; letter-spacing: .1em;
    color: rgba(255,255,255,.7); transition: opacity var(--t-fast);
  }

  /* The sound gate. Covers everything, so the choice is made before the lock screen can
     be touched at all. */
  .gate {
    position: fixed; inset: 0; z-index: 1100; display: grid; place-items: center;
    padding: var(--space-4); text-align: center; color: #fff;
    background: rgba(8,14,24,.86);
    -webkit-backdrop-filter: blur(28px) saturate(120%);
    backdrop-filter: blur(28px) saturate(120%);
    animation: fade var(--t-base) var(--ease);
  }
  .gate[hidden] { display: none; }
  .gate__card {
    display: grid; justify-items: center; gap: var(--space-2);
    width: min(420px, 100%); padding: var(--space-5) var(--space-4) var(--space-4);
    border-radius: 22px;
    background: var(--glass); border: var(--glass-line); box-shadow: var(--glass-sheen);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    animation: rise var(--t-base) var(--ease) both;
  }
  .gate__icon {
    display: grid; place-items: center; width: 54px; height: 54px; margin-bottom: var(--space-2);
    border-radius: 50%; color: #fff;
    background: var(--glass); border: var(--glass-line); box-shadow: var(--glass-sheen);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
  }
  .gate__eyebrow { margin: 0; font-size: 10px; letter-spacing: .3em; color: rgba(255,255,255,.6); }
  .gate__title { margin: 0; font-size: 22px; font-weight: 700; }
  .gate__body {
    margin: 0 0 var(--space-3); font-size: 13px; line-height: 1.5; color: rgba(255,255,255,.75);
  }
  /* Only what the shared .btn cannot know: this pair stacks, so the second needs a gap. */
  .gate__no { margin-top: var(--space-2); }

  /* Everything eases in once, so the screen assembles rather than just appearing.

     `backwards`, not `both`. A filled opacity animation makes an element a backdrop root
     for as long as it is filling, and `both` fills forever, so the unlock button inside
     .lock__bottom could only ever blur its own transparent parent instead of the clock
     behind it. `backwards` still holds the start frame through the delay, which is all
     the entrance needs, and lets go once the animation ends. */
  .lock__top, .lock__id { animation: rise var(--t-slow) var(--ease) backwards; }
  .lock__bottom { animation: fade var(--t-slow) var(--ease) backwards; }
  .lock__id { animation-delay: calc(var(--t-slow) * .15); }
  .lock__bottom { animation-delay: calc(var(--t-slow) * .3); }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes fade { from { opacity: 0; } }

  /* The token durations are zeroed globally under reduced motion, but these local
     hard-coded ones are not, so they need naming here. */
  @media (prefers-reduced-motion: reduce) {
    .lock__top, .lock__id, .lock__bottom { animation: none; }
    .lock__cta { transition: background var(--t-fast); }
    .lock__dot::after { animation: none; }
    .lock { transition-duration: 150ms; transform: none !important; }
  }

  .lock.is-open {
    opacity: 0; visibility: hidden; transform: translateY(-12px); pointer-events: none;
    transition: opacity 420ms var(--ease), transform 420ms var(--ease), visibility 0s linear 420ms;
  }

  @media (max-width: 640px) {
    .lock__time { font-size: clamp(64px, 26vw, 110px); }
    .lock__avatar { width: 56px; height: 56px; }
  }
</style>

<script>
  import { initLock } from '../../scripts/lock';
  initLock();
</script>
