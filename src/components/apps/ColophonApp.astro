---
/**
 * About this site. What it is, what it runs on, and who made the parts that are not mine.
 *
 * No script at all: it is static content in a window. The one build-time trick is reading
 * the Astro version out of package.json rather than typing it, so the stack this claims
 * cannot drift from the stack it actually runs.
 */
import { readFileSync } from 'node:fs';
import { site } from '../../data/site';

const pkg = JSON.parse(readFileSync('package.json', 'utf8'));
const astroVersion = (pkg.dependencies.astro as string).replace(/^\D+/, '').split('.')[0];

const stack = [
  ['Astro ' + astroVersion, 'Static build. Every page is finished HTML before anyone asks for it, so there is no server deciding anything at request time.'],
  ['Plain TypeScript', 'No React, no Vue, no framework. The things that move are small files that do one job each.'],
  ['Plain CSS', 'Every colour, size and duration lives in one tokens file, so changing the accent is one line.'],
  ['Cloudflare', 'Served as static assets from their edge.'],
  ['Space Mono', 'Self-hosted, latin only, both weights. 19KB, and it never blocks the page.'],
];

const credits = [
  ['Space Mono', 'Colophon Foundry, under the Open Font License', 'https://fonts.google.com/specimen/Space+Mono'],
  ['Pixelarticons', 'Gerrit Halfmann, MIT', 'https://pixelarticons.com/'],
  ['Astro', 'the Astro team', 'https://astro.build'],
  ['Playlist', 'Spotify', 'https://open.spotify.com/'],
];
---
<div class="colo">
  <section>
    <h3 class="colo__h">The idea</h3>
    <p>A portfolio that behaves like an operating system. You land on a lock screen, you get
    a desktop, and the work sits in windows you open yourself.</p>
    <p>I design interfaces, so it made more sense to build one than to write about it.</p>
  </section>

  <section>
    <h3 class="colo__h">Speed</h3>
    <p>Nothing loads that you did not ask for. No video, no embeds and no third-party
    scripts on arrival. The Spotify player is built when you open Music, and each app's
    code is fetched when you open its window, not before.</p>
    <p class="colo__note">Under 10KB of JavaScript on load, for the whole desktop.</p>
  </section>

  <section>
    <h3 class="colo__h">What it runs on</h3>
    <dl class="colo__stack">
      {stack.map(([name, why]) => (
        <div class="colo__row">
          <dt>{name}</dt>
          <dd>{why}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section>
    <h3 class="colo__h">Credit where it is due</h3>
    <ul class="colo__credits">
      {credits.map(([what, who, url]) => (
        <li>
          <a href={url} target="_blank" rel="noopener noreferrer">{what}</a> by {who}
        </li>
      ))}
    </ul>
    <p class="colo__note">The desktop icons and the wallpaper are mine. The tool logos in
    the dock are trademarks of their owners, here to name what I use, nothing more.</p>
  </section>

  <section>
    <h3 class="colo__h">Something broken?</h3>
    <p>Tell me and I will fix it. <button class="btn" type="button" data-open="contact">Send me a message</button></p>
  </section>
</div>

<style>
  .colo { display: grid; gap: var(--space-4); font-size: 13px; line-height: 1.6; max-width: 62ch; }
  .colo p { margin: 0 0 var(--space-2); }
  .colo p:last-child { margin-bottom: 0; }
  .colo__h {
    margin: 0 0 var(--space-2); font: 700 10px var(--font-chrome);
    letter-spacing: .18em; text-transform: uppercase; color: var(--os-muted);
  }
  .colo__note { color: var(--os-muted); font-size: 12px; }

  /* A description list, because that is what this is: a term and what it does. The row
     wrapper is what lets the pair sit side by side without a table. */
  .colo__stack { margin: 0; display: grid; gap: var(--space-2); }
  .colo__row { display: grid; grid-template-columns: 116px minmax(0, 1fr); gap: var(--space-3); }
  .colo__stack dt { font-weight: 700; }
  .colo__stack dd { margin: 0; color: var(--os-muted); }

  .colo__credits { margin: 0 0 var(--space-2); padding-left: 1.1em; display: grid; gap: 3px; }

  @media (max-width: 640px) {
    /* Two columns at 116px leaves nothing for the explanation on a phone, so it stacks. */
    .colo__row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
