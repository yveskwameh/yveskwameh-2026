---
/**
 * Mail. It feels like sending an email, and it is a form post.
 *
 * Deliberately not novalidate: an invalid form never fires submit at all, so the browser
 * has already checked everything by the time scripts/mail.ts sees it. That is validation
 * for nothing. And the form carries a real action, so with the script blocked the browser
 * posts it the ordinary way rather than doing nothing.
 *
 * Every string the states need lives here rather than in the script, for the same reason
 * as the lock screen copy: string literals are not minified, so copy in JS is charged
 * against the JS budget while copy in markup rides along in the gzipped HTML.
 *
 * One structural rule to know before adding anything: the sent state hides
 * `.compose > :not(.compose__done)`, which is DIRECT children only. A new block nested
 * inside a wrapper would stay on screen after sending.
 */
import { site } from '../../data/site';
import { contact } from '../../data/contact';

// Said once at build time rather than failing the build, so a missing key never blocks
// work on anything else. The composer still renders, it just falls back to the address.
if (!contact.accessKey) {
  console.warn('[mail] PUBLIC_WEB3FORMS_KEY is not set. The composer will show the email address instead of sending. See .env.example.');
}
---
<form class="compose" method="post" action={contact.endpoint}>
  <input type="hidden" name="access_key" value={contact.accessKey} />

  {/* The recipient as a pill, not an address. It says who this reaches without publishing
      the mailbox to every visitor and every scraper that reads the page. Display only:
      there is no field here, because Web3Forms routes on the access key above. */}
  <div class="compose__field">
    <span class="compose__label">To</span>
    <span class="compose__pill">
      <img src={site.avatar} alt="" width="26" height="26" loading="lazy" decoding="async" />
      {site.name}
    </span>
  </div>

  <label class="compose__field">
    <span class="compose__label">From</span>
    <input class="compose__input" type="email" name="email" required
           autocomplete="email" maxlength="120" placeholder="your email address" />
  </label>

  <label class="compose__field">
    <span class="compose__label">Subject</span>
    <input class="compose__input" type="text" name="subject" required
           maxlength="120" placeholder="What is this about?" />
  </label>

  <label class="compose__field compose__field--body">
    <span class="sr-only">Message</span>
    <textarea class="compose__body" name="message" required maxlength="4000"
              placeholder="Just write anything. It does not have to be about work."></textarea>
  </label>

  {/* Bots fill this in, people never see it. Cheaper than a captcha and it costs nothing
      on the page. The name is the one the form service checks for. */}
  <div class="compose__trap" aria-hidden="true">
    <label>Do not fill this in<input type="checkbox" name="botcheck" tabindex="-1" /></label>
  </div>

  {/* The escape hatch, so a failed send never just swallows what someone wrote. The
      address rides in the href rather than on screen. */}
  <p class="compose__failed" role="status">
    That did not send. <a href={`mailto:${site.email}`}>Email me directly</a>.
  </p>

  <div class="compose__actions">
    {/* data-close is all this needs: the window manager's delegated listener already
        handles it, so Cancel costs no JS. */}
    <button class="btn btn--secondary" type="button" data-close="contact">Cancel</button>
    <button class="btn compose__send" type="submit">
      <span class="compose__send-idle">Send Email</span>
      <span class="compose__send-busy">Sending</span>
    </button>
  </div>

  <div class="compose__done" role="status">
    <p class="compose__done-title">Message sent.</p>
    <p>I will get back to you.</p>
    <button class="btn btn--secondary" type="button" data-compose-again>Write another</button>
  </div>
</form>

<style>
  /* Flex rather than a fixed grid template: three of these rows show and hide with the
     send state, and a row template would have to be rewritten every time one did. */
  .compose { display: flex; flex-direction: column; min-height: 0; font-size: 13px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* 76px for the label column: "Subject" in Space Mono at 12px is about 50px wide and the
     column also carries 16px of left padding, so anything narrower runs the two together. */
  .compose__field {
    display: grid; grid-template-columns: 76px minmax(0, 1fr); align-items: center;
    border-bottom: 1px solid var(--os-hairline);
    transition: background var(--t-fast);
  }
  /* Bold, so the label reads as the label and the field reads as what was typed. That
     weight difference is the only thing separating them, since neither has a box. */
  .compose__label { padding-left: var(--space-3); font-size: 12px; font-weight: 700; }
  .compose__field--body { grid-template-columns: minmax(0, 1fr); flex: 1; min-height: 0; border-bottom: 0; }
  /* Focus, without a box. A ring drawn around the field is not what a mail composer should
     feel like, so the whole row lifts instead and the caret does the rest. */
  .compose__field:focus-within { background: rgba(255,255,255,.72); }

  /* The recipient chip: a rounded pill with the avatar tucked into its left end, sized so
     it reads as one object rather than a picture next to some text. justify-self: start so
     it hugs the name instead of stretching across the row the way a grid item otherwise
     would. */
  .compose__pill {
    justify-self: start; display: inline-flex; align-items: center; gap: 9px;
    margin: 8px 0; padding: 5px 16px 5px 5px; border-radius: var(--r-pill);
    background: var(--os-hover); font-size: 13px; line-height: 1;
  }
  .compose__pill img { width: 26px; height: 26px; border-radius: 50%; }

  /* Targeted resets, deliberately NOT `all: unset`. On a textarea that also resets
     white-space from the UA's pre-wrap back to normal, which collapses every newline the
     visitor types and makes their message arrive as one paragraph. */
  .compose__input, .compose__body {
    box-sizing: border-box; width: 100%; min-width: 0;
    border: 0; background: none; color: inherit; font: inherit;
  }
  /* Regular weight against the bold label. */
  .compose__input { padding: 12px var(--space-3) 12px 0; font-weight: 400; }
  .compose__body { height: 100%; padding: var(--space-3); line-height: 1.55; resize: none; overflow: auto; }

  /* :user-invalid, not :invalid. :invalid matches an untouched required field the instant
     the page renders, so it would paint every row red before anyone had typed a thing.
     A bar down the edge rather than a ring, to stay out of the way of the focus rule above. */
  .compose__input:user-invalid, .compose__body:user-invalid { box-shadow: inset 3px 0 0 var(--light-close); }
  /* The site-wide focus ring is an outer box-shadow and a full-bleed row would clip it,
     so it is turned off here and :focus-within on the row does the job instead. */
  .compose__input:focus, .compose__input:focus-visible,
  .compose__body:focus, .compose__body:focus-visible { outline: none; box-shadow: none; }

  /* Cancel on the left, Send on the right, the way the reference has it. */
  .compose__actions {
    display: flex; align-items: center; gap: var(--space-2);
    padding: 10px var(--space-3); border-top: 1px solid var(--os-hairline);
  }
  .compose__send { margin-left: auto; }
  .compose__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* Three states, one attribute. scripts/mail.ts only ever writes data-state. */
  .compose__send-busy, .compose__failed, .compose__done { display: none; }
  .compose[data-state='sending'] .compose__send { pointer-events: none; opacity: .6; }
  .compose[data-state='sending'] .compose__send-idle { display: none; }
  .compose[data-state='sending'] .compose__send-busy { display: inline; }
  .compose[data-state='failed'] .compose__failed {
    display: block; margin: 0; padding: 0 var(--space-3) 10px;
    color: var(--light-close-line); font-size: 12px;
  }
  /* A sent message replaces the composer rather than sitting under it, so there is no
     half-filled form left on screen suggesting it might send twice. Direct children only,
     which is why every block above is one. */
  .compose[data-state='sent'] > :not(.compose__done) { display: none; }
  .compose[data-state='sent'] .compose__done {
    display: grid; align-content: center; justify-items: center; gap: var(--space-2);
    padding: var(--space-4); text-align: center; flex: 1;
  }
  .compose__done p { margin: 0; }
  .compose__done-title { font-weight: 700; }
</style>
