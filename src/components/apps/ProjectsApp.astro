---
/**
 * Work, laid out like macOS System Settings. Sidebar of case studies on the left, one
 * case study on the right, with its facts in grouped cards above the write-up.
 *
 * The switching is CSS. Every row is a radio and every pane is the element directly after
 * that radio's label, so `radio:checked + label + pane` picks exactly one. That means the
 * window works the instant it opens rather than when a script lands, it keeps working if
 * the script never arrives, arrow keys move between rows for free because it is a real
 * radio group, and none of it is charged against the JS budget. The price is that the
 * rows cannot sit inside a <nav> or a <ul>, because a wrapper breaks the adjacency, so
 * the sidebar's background is painted on the grid instead of on a wrapper. A <fieldset>
 * is the right grouping element for a radio set anyway.
 *
 * Every pane is rendered at build time, per rule 3. Nothing is fetched when you switch.
 */
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year,
);
const panes = await Promise.all(
  projects.map(async (p) => ({ p, Content: (await render(p)).Content })),
);
---
<fieldset class="settings">
  <legend class="sr-only">Case studies</legend>

  {projects.length === 0 && (
    /* Keeps the chrome rather than replacing it, so the window still reads as the two
       column thing it is. A real radio like any other, just disabled, so the DOM shape
       stays identical and the "show the first pane" rule below still lights it up. */
    <Fragment>
      <input class="settings__radio" type="radio" name="work" id="w-none" disabled />
      <label class="settings__row" for="w-none">
        <span class="settings__icon settings__icon--blank"></span>
        <span class="settings__name">Nothing here yet</span>
      </label>
      <article class="settings__pane">
        <header class="pane__hero">
          <span class="pane__hero-icon pane__hero-icon--blank"></span>
          <h3 class="pane__title">No case studies yet</h3>
          <p class="pane__blurb">Add a markdown file to src/content/projects and it shows up here, and at its own URL.</p>
        </header>
      </article>
    </Fragment>
  )}

  {panes.map(({ p, Content }) => (
    <Fragment>
      <input class="settings__radio" type="radio" name="work" id={`w-${p.id}`} value={p.id} />
      {/* One line of text next to a small icon, the way a Settings sidebar reads. The
          client and the year used to sit under the title on a second line and made the
          list heavy; they are facts about the project, so they live in the pane with the
          other facts instead. */}
      <label class="settings__row" for={`w-${p.id}`}>
        <img class="settings__icon" src={p.data.cover} alt="" width="20" height="20" loading="lazy" decoding="async" />
        <span class="settings__name">{p.data.title}</span>
      </label>

      <article class="settings__pane">
        <header class="pane__hero">
          <img class="pane__hero-icon" src={p.data.cover} alt="" width="72" height="72" loading="lazy" decoding="async" />
          <h3 class="pane__title">{p.data.title}</h3>
          <p class="pane__blurb">{p.data.summary}</p>
        </header>

        <dl class="pane__facts">
          <div class="pane__fact"><dt>Client</dt><dd>{p.data.client}</dd></div>
          <div class="pane__fact"><dt>Year</dt><dd>{p.data.year}</dd></div>
          <div class="pane__fact"><dt>Role</dt><dd>{p.data.role}</dd></div>
          <div class="pane__fact"><dt>Built with</dt><dd>{p.data.stack.join(', ')}</dd></div>
        </dl>

        <div class="pane__body"><Content /></div>

        {/* The "open as its own page" link is gone: this window already IS the case study,
            and sending someone out of it was the odd move. /work/<id> still exists as a
            real, indexable URL and still links back here. */}
        {p.data.url && (
          <p class="pane__links">
            <a href={p.data.url} target="_blank" rel="noopener noreferrer">Visit the live site</a>
          </p>
        )}
      </article>
    </Fragment>
  ))}
</fieldset>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* The browser fills the whole window and its panes do their own scrolling, so the
     window body's padding has to go. Matched by what is inside rather than by window id. */
  :global(.window__body:has(> .settings)) { padding: 0; overflow: hidden; }

  .settings {
    --side: 208px;
    position: relative;
    display: grid; grid-template-columns: var(--side) minmax(0, 1fr); align-content: start;
    height: 100%; min-width: 0; margin: 0; padding: 0; border: 0;
    background: linear-gradient(to right, var(--os-chrome) 0 var(--side), var(--os-recess) var(--side));
  }

  /* Out of flow so it takes no grid slot, but still focusable and still a real radio, so
     the browser's own arrow-key navigation through the group keeps working.
     display: none would take that away. */
  .settings__radio { position: absolute; width: 1px; height: 1px; opacity: 0; }

  .settings__row {
    grid-column: 1;
    display: grid; grid-template-columns: 20px minmax(0, 1fr); align-items: center; gap: 10px;
    margin: 1px var(--space-2); padding: 6px var(--space-2);
    border-radius: var(--r-inner); cursor: var(--cur-hand);
    font: 12px var(--font-chrome); color: var(--os-ink);
  }
  .settings__icon { width: 20px; height: 20px; border-radius: 5px; object-fit: cover; }
  .settings__icon--blank { display: block; background: rgba(22,22,26,.12); }
  /* One line, and it stays one line: a long title gets an ellipsis rather than wrapping
     and making its row taller than the others. */
  .settings__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .settings__row:hover { background: rgba(22,22,26,.06); }
  .settings__radio:checked + .settings__row { background: var(--os-accent); color: #fff; }
  .settings__radio:focus-visible + .settings__row { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--os-accent); }
  /* A disabled row is not going anywhere, so it should not pretend to be clickable. */
  .settings__radio:disabled + .settings__row { cursor: var(--cur-arrow); }
  .settings__radio:disabled + .settings__row:hover { background: none; }

  /* Absolutely positioned rather than spanning grid rows, so the pane never has to know
     how many case studies there are. It fills the whole right side whatever the sidebar
     is doing, and it scrolls itself, the way the real thing does. */
  .settings__pane {
    position: absolute; inset: 0; left: var(--side);
    display: none; overflow: auto; padding: var(--space-4);
  }
  .settings__radio:checked + .settings__row + .settings__pane { display: block; }

  /* The header and the facts are cards on a recessed background, which is the pattern the
     whole of System Settings is built from. */
  .pane__hero {
    display: grid; justify-items: center; gap: 6px; text-align: center;
    padding: var(--space-4) var(--space-3);
    background: var(--os-card); border-radius: var(--r-window);
  }
  .pane__hero-icon { width: 72px; height: 72px; border-radius: 18px; margin-bottom: 4px; }
  .pane__hero-icon--blank { display: block; background: rgba(22,22,26,.12); }
  .pane__title { margin: 0; font: 700 17px var(--font-chrome); }
  .pane__blurb { margin: 0; max-width: 44ch; color: var(--os-muted); font-size: 12px; line-height: 1.55; }

  .pane__facts {
    margin: var(--space-3) 0 0; padding: 0 var(--space-3);
    background: var(--os-card); border-radius: var(--r-window);
  }
  .pane__fact {
    display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: var(--space-3);
    padding: 9px 0; font-size: 12px;
  }
  /* Divider between rows but not under the last one, same as a Settings group. */
  .pane__fact + .pane__fact { border-top: 1px solid rgba(22,22,26,.08); }
  .pane__facts dt { color: var(--os-muted); }
  .pane__facts dd { margin: 0; }

  /* One card per section, the way Settings stacks separate groups down a page.
     Done in CSS rather than by cutting the markdown up at build time: a heading opens a
     card and whatever sits before the next heading closes it, so it works for any case
     study without changing how case studies are written. */
  .pane__body { margin-top: var(--space-3); font-size: 13px; line-height: 1.65; }
  .pane__body :global(> *) {
    margin: 0; padding: 0 var(--space-4);
    background: var(--os-card);
  }
  .pane__body :global(> h2) {
    margin-top: var(--space-3); padding-top: var(--space-3);
    border-radius: var(--r-window) var(--r-window) 0 0;
    font: 700 10px var(--font-chrome); letter-spacing: .16em; text-transform: uppercase;
    color: var(--os-muted);
  }
  .pane__body :global(> h2:first-child) { margin-top: 0; }
  .pane__body :global(> h2 + *) { padding-top: var(--space-2); }
  /* The last element of a section, and the last of the whole body, close their card. */
  .pane__body :global(> :has(+ h2)),
  .pane__body :global(> :last-child) {
    padding-bottom: var(--space-3);
    border-radius: 0 0 var(--r-window) var(--r-window);
  }
  /* Space between paragraphs inside a card, without breaking the card open. */
  .pane__body :global(> p + p) { padding-top: var(--space-2); }

  /* Case study screenshots. A raw <img> in the markdown is a direct child of the body, so
     it is a card in its own right, which is exactly right: the picture gets its own panel
     the way a Settings group does. */
  .pane__body :global(> img) {
    width: 100%; height: auto; padding: 0;
    border-radius: var(--r-window);
  }
  .pane__body :global(> img + *) { margin-top: var(--space-3); }

  /* A card too, so it stops reading as text floating under the stack. */
  .pane__links {
    display: flex; flex-wrap: wrap; gap: var(--space-3);
    margin: var(--space-3) 0 0; padding: 12px var(--space-4);
    background: var(--os-card); border-radius: var(--r-window);
    font-size: 12px;
  }

  /* Before anything is picked, show the first one, the way Settings opens on General.
     Doing this in CSS rather than with a checked attribute in the markup is what lets the
     phone open as a plain list instead of pre-expanded. */
  @media (min-width: 641px) {
    .settings:not(:has(:checked)) > .settings__pane:first-of-type { display: block; }
    .settings:not(:has(:checked)) > .settings__row:first-of-type { background: var(--os-accent); color: #fff; }
  }

  @media (max-width: 640px) {
    /* Under 640px the window is already a bottom sheet, and a two-column browser is
       unusable at 320px. So the pane drops in under its own row rather than beside it,
       which is what a phone settings list does. A hidden pane leaves the flow entirely,
       so the open one always lands directly beneath the row that opened it. */
    .settings { grid-template-columns: minmax(0, 1fr); background: var(--os-recess); }
    .settings__row { margin: 0; border-radius: 0; border-bottom: 1px solid rgba(22,22,26,.08); background: var(--os-chrome); }
    .settings__pane { position: static; grid-column: 1; padding: var(--space-3); overflow: visible; }
  }
</style>
