---
/**
 * Music. Two sources: Yves's own hosted tracks up top, and the Spotify playlist below.
 * Neither loads on page open. The audio element carries preload="none" and the Spotify
 * iframe is only created once the window is opened.
 */
import { tracks } from '../../data/tracks';
import Icon from './../os/Icon.astro';
---
<div class="music">
  {tracks.length > 0 && (
    <ul class="music__list">
      {tracks.map((t) => (
        <li class="music__row">
          <button class="btn btn--icon" type="button" data-track={t.src} aria-label={`Play ${t.title}`}>
            <Icon name="play" size={14} />
          </button>
          <span class="music__meta"><strong>{t.title}</strong><br />{t.artist}</span>
        </li>
      ))}
    </ul>
  )}

  <p class="music__label">PLAYLIST</p>
  <div id="spotify-box"><p class="music__empty">Loading the playlist from Spotify…</p></div>
</div>

<style>
  .music { min-height: 200px; display: grid; gap: var(--space-3); }
  .music__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .music__row { display: flex; align-items: center; gap: var(--space-3); }
  .music .btn--icon { flex: none; }
  .music__meta { font-size: 13px; line-height: 1.35; }
  .music__label { margin: 0; font: 10px var(--font-chrome); letter-spacing: .16em; color: var(--os-muted); }
  .music__empty { font: 12px var(--font-mono); color: var(--os-muted); margin: 0; }
</style>
