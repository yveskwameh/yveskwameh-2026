---
/**
 * Window chrome: traffic lights (close / minimise / zoom), drag by title bar,
 * resize from the bottom-right corner. `filename` is the caption under the window.
 */
interface Props {
  id: string; title: string; filename?: string;
  width?: number; height?: number;
  /** Render already open. The standalone case-study pages pass this. */
  open?: boolean;
  /** Chrome variant. 'compose' anchors the window bottom right and slides it up. */
  variant?: 'compose';
  /**
   * Turn the close light into a link to here. The standalone case-study pages need this:
   * they render a window but never load the window manager, so on those pages the close
   * button would be a control that visibly does nothing.
   */
  closeHref?: string;
  /**
   * Render the title as the page's h1 instead of an h2.
   *
   * On the desktop many windows are open at once, so each one is a section and h2 is
   * right. On a standalone case-study page the single window IS the page, and a page
   * whose subject has no h1 is missing the strongest heading signal there is, as well as
   * the landmark a screen reader user navigates by.
   */
  main?: boolean;
  /**
   * Turn the green light on. It fills the desktop and restores, the way zoom does on a
   * Mac, and it is a checkbox rather than a script so it costs nothing on load.
   *
   * Opt in per window on purpose. Mail is anchored to a corner and the game asks for a
   * fixed height, so a window that fills the screen is wrong for both. Work wants it,
   * because a case study is mostly pictures and pictures want width.
   */
  zoomable?: boolean;
}
const { id, title, filename, width = 560, height, open = false, variant, closeHref, main = false, zoomable = false } = Astro.props;
---
<section
  class:list={['window', variant && `window--${variant}`, { 'is-open': open, 'is-focused': open }]}
  id={`win-${id}`}
  data-window={id}
  role="dialog"
  aria-labelledby={`win-${id}-title`}
  style={`--w:${width}px;${height ? `--h:${height}px;` : ''}`}
>
  {/* The sheet's grab handle. Nothing above 640px, where a window is a window and the
      title bar is what you drag. On a phone it is the thing a thumb reaches for, and
      scripts/drag.ts hangs the swipe-to-dismiss off it and the title bar together. */}
  {/* Zoom, held in a checkbox so the state lives in the DOM and no script is needed.
      Inside .window on purpose: the rule that reads it is .window:has(), and :has only
      looks at descendants. */}
  {zoomable && <input class="window__zoom-state" type="checkbox" id={`zoom-${id}`} tabindex="-1" aria-hidden="true" />}
  <div class="window__grab" aria-hidden="true"></div>
  <div class="window__titlebar">
    <div class="window__lights">
      {closeHref
        ? <a class="light light--close" href={closeHref} aria-label="Back to the desktop"></a>
        : <button class="light light--close" data-close={id} aria-label="Close"></button>}
      {/* Drawn but inactive, and disabled rather than merely grey so they are also out of
          the tab order and out of the click handler. There is nowhere on this desktop to
          minimise a window TO, and zoom fights the fixed two-column layout inside Work and
          the corner anchoring of Mail, so leaving either live would promise something the
          OS does not really do. macOS greys out the ones a window does not support. */}
      <button class="light light--min" aria-label="Minimise (unavailable)" disabled></button>
      {zoomable
        ? <label class="light light--zoom" for={`zoom-${id}`} title="Zoom"><span class="sr-only">Zoom</span></label>
        : <button class="light light--zoom" aria-label="Zoom (unavailable)" disabled></button>}
    </div>
    {/* Both tags written out rather than one dynamic tag name, so Astro can see them and
        scope .window__title to them. A computed tag is not always visible to the scoper,
        and a heading that quietly loses its styling is a hard thing to notice. */}
    {main
      ? <h1 class="window__title" id={`win-${id}-title`}>{title}</h1>
      : <h2 class="window__title" id={`win-${id}-title`}>{title}</h2>}
    {/* Anything a window wants beside its title, and it has to come AFTER the title or the
        title gets pushed along in front of it. Work puts its sidebar toggle here, which is
        where a Mac keeps one. Empty on every other window, and an empty slot renders
        nothing at all. */}
    <slot name="toolbar" />
  </div>
  <div class="window__body"><slot /></div>
  {/* Eight grips, one per edge and corner. data-resize holds the DIRECTION now, not the
      window id, which is what scripts/drag.ts reads to decide which edges to move. */}
  {['n', 'e', 's', 'w', 'ne', 'nw', 'se', 'sw'].map((d) => (
    <span class={`window__grip window__grip--${d}`} data-resize={d} aria-hidden="true"></span>
  ))}
</section>
{filename && <p class="window__filename" data-filename-for={id}>{filename}</p>}

<style>
  .window {
    position: absolute; top: var(--window-top); left: 18%; width: min(var(--w), calc(100vw - 32px)); height: var(--h, auto);
    /* A window may ask for more height than the desktop has. The game asks for a lot on
       purpose, so it opens tall enough to read the conversation in, and this is what
       keeps that from running off the bottom on a short screen. Sits above the dock. */
    max-height: calc(100% - var(--window-top) - var(--window-bottom));
    min-width: 280px; min-height: 160px; display: none; flex-direction: column;
    /* clip, not hidden. An overflow: hidden box is still a scroll container, and the
       browser will scroll it to bring a focused element into view, with no scrollbar and
       no way for anybody to scroll it back. The Services rows are labels for hidden
       checkboxes, and clicking one below the fold scrolled the whole window box: title
       bar gone out of the top, a transparent band at the bottom, and it stayed that way.
       overflow: clip clips exactly the same, corners included, and cannot be scrolled by
       anything. */
    overflow: clip;
    /* Deliberately no background. The title bar is glass, and glass needs something
       behind it, so the surface colour moved down onto .window__body. Same split macOS
       makes: chrome is vibrant, content is solid, because a case study has to stay
       readable and a wallpaper showing through body text does not help anyone. */
    border: var(--os-border); border-radius: var(--r-window); box-shadow: var(--os-shadow);
    transition: opacity var(--t-fast);
  }
  .window.is-open { display: flex; }
  .window__titlebar {
    flex: none; height: var(--titlebar-h); display: flex; align-items: center; gap: var(--space-2); padding: 0 10px;
    /* Kept translucent on purpose. Everything else went back to how it was before the
       glass round, but a see-through title bar over the wallpaper is the one part of it
       worth keeping. */
    background: var(--os-titlebar);
    -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid var(--os-edge);
    cursor: var(--cur-grab); touch-action: none; user-select: none;
  }
  /* Both states. :active covers holding the bar down, and .is-dragging is what
     scripts/drag.ts actually puts on the window, which until now no CSS matched at all. */
  .window__titlebar:active,
  .window.is-dragging .window__titlebar { cursor: var(--cur-grabbing); }
  .window__lights { display: flex; gap: 8px; }
  /* display: block so this works as an <a> as well as a <button>, for closeHref above. */
  /* Nothing on a desktop: a window is dragged by its title bar there, and a grab handle
     on a thing that does not lift off the bottom of the screen would be a lie. The phone
     block at the end of this file is the only place it exists. */
  .window__grab { display: none; }
  .light { display: block; width: 12px; height: 12px; border-radius: 50%; padding: 0; cursor: var(--cur-hand); border: 1px solid; }
  .light--close { background: var(--light-close); border-color: var(--light-close-line); }
  /* The inactive pair. Same grey the whole set goes when the window is not focused. */
  .light--min, .light--zoom { background: #d5d5d3; border-color: #c2c2c0; cursor: var(--cur-arrow); }
  /* macOS: lights go grey when the window is not focused, and the close symbol appears on
     hover. Only close gets a symbol now, because it is the only one that does anything. */
  .window:not(.is-focused) .light { background: #d5d5d3; border-color: #c2c2c0; }
  /* content is what was missing here: without it the pseudo-element is never generated,
     so this x had never once appeared in any state. */
  .window__lights:hover .light--close::before {
    content: ''; display: block; margin: 2px auto; width: 6px; height: 6px;
    background-image:
      linear-gradient(45deg, transparent 43%, rgba(0,0,0,.6) 43% 57%, transparent 57%),
      linear-gradient(-45deg, transparent 43%, rgba(0,0,0,.6) 43% 57%, transparent 57%);
  }
  /* A 12px dot is a small thing to hit, and a near miss lands on the title bar and starts
     a drag instead. This grows the hit area to 18px without changing what you see. Only
     3px: the lights sit 8px apart, so more would have them overlapping each other. */
  .light { position: relative; }
  .light::after { content: ''; position: absolute; inset: -3px; border-radius: 50%; }
  /* Left aligned, sitting just after the traffic lights, rather than centred in the bar. */
  .window__title { margin: 0; font: 11px var(--font-chrome); letter-spacing: .02em; }

  /* ------------------------------------------------------------------
     Zoom, with no JavaScript.

     The checkbox holds the state and the green light is its label, so the whole feature
     is one rule. !important is load bearing here rather than lazy: scripts/drag.ts and
     the resize grips write left, top, width and height inline, and a zoomed window has to
     beat all four. Because they only override and never erase, unzooming drops straight
     back to wherever the window was dragged to and whatever size it was resized to.

     It also means a zoomed window cannot be resized, which is correct: on a Mac it cannot
     either. Dragging still works and simply does nothing visible until it is restored.
     ------------------------------------------------------------------ */
  .window__zoom-state { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  /* The green light is a label, and a label with no text is unreadable to a screen reader.
     Declared here rather than globally because this file is the only one that needs it. */
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .light--zoom[for] { cursor: var(--cur-hand); }
  /* The same + symbol macOS draws, appearing on hover like the close x. */
  .window__lights:hover .light--zoom[for]::before {
    content: ''; display: block; margin: 2px auto; width: 6px; height: 6px;
    background-image:
      linear-gradient(to bottom, transparent 43%, rgba(0,0,0,.6) 43% 57%, transparent 57%),
      linear-gradient(to right, transparent 43%, rgba(0,0,0,.6) 43% 57%, transparent 57%);
  }
  @media (min-width: 641px) {
    .window:has(.window__zoom-state:checked) {
      left: 0 !important;
      top: var(--window-top) !important;
      width: 100vw !important;
      height: calc(100% - var(--window-top) - var(--window-bottom)) !important;
      max-height: none;
      border-radius: 0;
    }
  }
  /* Carries the surface colour now that .window itself is transparent. */
  .window__body { flex: 1; min-height: 0; padding: var(--space-3); overflow: auto; background: var(--os-surface); }
  /* Resize grips. Six pixels of grab area straddling each edge, and the corners sit on
     top of the edges so a corner drag wins where they overlap. They are invisible: the
     cursor is the affordance, which is how a real window manager does it. */
  .window__grip { position: absolute; touch-action: none; }
  .window__grip--n { top: -3px; left: 10px; right: 10px; height: 6px; cursor: var(--cur-ns); }
  .window__grip--s { bottom: -3px; left: 10px; right: 10px; height: 6px; cursor: var(--cur-ns); }
  .window__grip--w { left: -3px; top: 10px; bottom: 10px; width: 6px; cursor: var(--cur-ew); }
  .window__grip--e { right: -3px; top: 10px; bottom: 10px; width: 6px; cursor: var(--cur-ew); }
  .window__grip--nw, .window__grip--ne, .window__grip--sw, .window__grip--se { width: 14px; height: 14px; }
  .window__grip--nw { top: -3px; left: -3px; cursor: var(--cur-nwse); }
  .window__grip--se { bottom: -3px; right: -3px; cursor: var(--cur-nwse); }
  .window__grip--ne { top: -3px; right: -3px; cursor: var(--cur-nesw); }
  .window__grip--sw { bottom: -3px; left: -3px; cursor: var(--cur-nesw); }
  .window__filename { display: none; }

  /* ------------------------------------------------------------------
     Compose. Mail sits in the bottom right corner over a desktop you can still use,
     the way Gmail does, instead of arriving as another centred window.

     It is still an ordinary .window, which is the whole reason this is six lines: close,
     minimise, zoom, focus, z-order, the dim-others rule, Escape, drag, resize and the
     mobile bottom sheet all already exist and all still apply. Only where it sits and how
     it arrives are different, and both are CSS.

     Dragging it works without any special case. drag.ts writes style.left and style.top,
     and an element given both left and right is over-constrained, so the browser drops
     right on its own. It starts anchored to the corner and becomes a normal window the
     moment you move it.
     ------------------------------------------------------------------ */
  @media (min-width: 641px) {
    .window.window--compose {
      max-height: calc(100% - var(--window-top) - var(--window-bottom));
    }
    /* An animation rather than a transition, because display: none to flex restarts an
       animation and cancels a transition outright. --t-base is already zeroed under
       reduced motion, so this needs no media query of its own.

       It only fades and lifts a little now. It used to slide up from the bottom right
       corner, which was where the panel lived; it opens in the middle like everything
       else, so a long travel would look wrong. */
    .window.window--compose.is-open { animation: compose-in var(--t-base) var(--ease); }
  }
  /* No body padding: the compose rows draw their own dividers edge to edge. */
  .window--compose .window__body { padding: 0; overflow: hidden; display: grid; }
  @keyframes compose-in { from { opacity: 0; transform: translateY(8px) scale(.98); } }

  /* ------------------------------------------------------------------
     The phone. A window stops being a window and becomes a bottom sheet: it rises from
     the bottom edge, covers the dock instead of stepping around it, and the scrim behind
     it dims everything but the menu bar.

     --window-bottom is 0 here (tokens.css), so `bottom` and `max-height` below both
     follow from that one value, as do the per-window height pins in GameApp and MailApp.
     ------------------------------------------------------------------ */
  @media (max-width: 640px) {
    .window {
      top: auto !important; bottom: var(--window-bottom); left: 0 !important;
      width: 100vw !important; height: auto !important;
      max-height: calc(100dvh - var(--menubar-h) - var(--window-top) - var(--window-bottom));
      /* Top corners only. A sheet has no bottom corners, it has an edge of the screen. */
      border-radius: var(--r-window) var(--r-window) 0 0;
      /* The dock is z-index 800 and .desktop creates no stacking context, so a window
         competes with it directly. It has to win, or the dock draws over the sheet.
         !important because focusWindow writes an inline z-index, and a fixed value is
         safe because closeOthers keeps exactly one window open at a time. */
      z-index: 810 !important;
      /* The sheet reaches the true bottom edge, so on a phone with a home indicator the
         last row of content would sit under it. The dock already does this at Dock.astro. */
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    /* Slides in AND out, with no script. `display` cannot be transitioned on its own, so
       allow-discrete holds the element visible for the length of the exit, and
       @starting-style gives the entrance somewhere to come from. A browser without either
       simply snaps, which is exactly what every window did here before today. */
    .window {
      translate: 0 100%;
      transition: opacity var(--t-fast),
                  translate var(--t-base) var(--ease),
                  display var(--t-base) allow-discrete;
    }
    .window.is-open { translate: 0 0; }
    @starting-style { .window.is-open { translate: 0 100%; } }
    /* While a finger is on it, drag.ts writes `translate` inline every frame and the
       transition has to be out of the way or the sheet lags behind the thumb. */
    .window.is-swiping { transition: none; }

    .window__grab {
      display: grid; place-items: center; flex: none; height: 18px;
      background: var(--os-titlebar); cursor: grab; touch-action: none;
    }
    .window__grab::after {
      content: ''; display: block; width: 36px; height: 4px; border-radius: var(--r-pill);
      background: var(--os-line);
    }
    /* The title bar is the other half of the grab area, so a thumb landing anywhere in
       the chrome starts the gesture rather than only on a 4px pill. */
    .window__titlebar { touch-action: none; }
    .window__grip { display: none; }
  }
</style>
