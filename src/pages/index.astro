---
import Base from '../layouts/Base.astro';
import LockScreen from '../components/os/LockScreen.astro';
import MenuBar from '../components/os/MenuBar.astro';
import Desktop from '../components/os/Desktop.astro';
import Dock from '../components/os/Dock.astro';
import { website, person, profilePage } from '../data/schema';

/* The home page is where the Person is declared in full. Every case study points back at
   this node by @id rather than repeating it, so a crawler reading the whole site sees one
   Yves, described once. */
const schema = [website(Astro.site!), person(Astro.site!), profilePage(Astro.site!)];
---

{/* One title and one description, no og overrides. They used to be three different
    sentences: a job label for search, a different line for social, and a third one
    inherited from Base because this page never set `description` at all. So Google and
    LinkedIn showed a visitor two different sites. Base already falls the og fields back
    to these two, which is why there is nothing else to set here. */}
<Base
  title="Yves Kwameh, UX/UI designer and no-code developer"
  description="I design interfaces and build them, so the thing that ships is the thing that was designed. Six case studies are here, each one in a window you open."
  schema={schema}
>
  <LockScreen />
  <MenuBar />
  <Desktop />
  <Dock />
</Base>
