# Cloudflare static assets reads this the same way Pages does. Rules are matched in order
# and the most specific match wins, so the site-wide block goes first and the long-cache
# globs after it.
#
# Two separate problems are solved here. The first is that the site shipped no security
# headers at all. The second is that content-hashed files were being revalidated on every
# repeat visit, which is the one kind of request that never needs to happen.

/*
  # Say HTTPS only, for two years, including subdomains. Safe to assert now: Always Use
  # HTTPS is on at the zone, every host variant 301s to the apex over TLS, and the
  # certificate covers www. Worth knowing before changing it: a browser that has seen
  # this header will refuse plain http to this domain for the full max-age and there is
  # no way to call that back other than waiting it out or serving max-age=0 for as long
  # as it takes every visitor to come back. Do not add `preload` without meaning it.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # Take the declared Content-Type at its word and never sniff. The one that actually
  # matters here: without it a browser may decide a .txt or an .avif is something
  # executable based on its bytes.
  X-Content-Type-Options: nosniff
  # Send the full URL to ourselves, only the origin to anyone else. Case study paths name
  # clients, and those should not travel in a Referer header to a third party.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here asks for a camera, a microphone or a location, so nothing should be able
  # to. An empty allowlist denies the feature outright rather than prompting.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Clickjacking. The site is a desktop full of buttons, which is exactly the kind of
  # thing worth framing invisibly over something else.
  X-Frame-Options: DENY

# Caching, and the rule that decides which block a path belongs in: `immutable` is only
# honest when the filename changes with the bytes. It tells a browser never to revalidate,
# not even to ask, so a file served that way and later edited in place is frozen in every
# cache that already holds it until the max-age runs out.
#
# That is not a theory. `/images/*` was in the immutable block below with a one year
# max-age, and the six case study icons were replaced with the real brand marks under
# their existing filenames. Anyone who had loaded the site before that kept the old flat
# squares and their browser never asked again. The same applied to a wireframe shot that
# was re-exported to fix overlapping text. The server was serving the right bytes the
# whole time and no cache was going to collect them.
#
# HTML is deliberately absent from both blocks. A page must be revalidated or a deploy
# would not reach anyone who had already visited.

# Content-hashed by the build. The filename carries a digest, so a changed file is a new
# URL and `immutable` is earned rather than asserted.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Everything below lives in public/ and is copied through verbatim, so the filenames are
# stable and editing a file in place keeps its URL. These get a day of freshness and then
# a month during which a stale copy may be served instantly while a fresh one is fetched
# behind it, so a repeat visit is still served from cache and an edit still lands.
#
# The cost is one conditional request per asset per day, answered with a 304 when nothing
# changed. Lighthouse's long cache TTL check is a zero weight diagnostic rather than part
# of the performance score, so this does not move the number.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/cursors/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
