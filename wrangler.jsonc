{
  // Cloudflare Workers. Static assets first, with one small Worker behind them.
  //
  // The site is still entirely static: Cloudflare serves a file from ./dist whenever the
  // path matches one, and only falls through to the Worker when it does not. The Worker
  // exists for exactly one route, /ws, which is the websocket the live cursors talk over.
  // No Astro adapter, no SSR, nothing about the pages changed.
  //
  // Docs: https://developers.cloudflare.com/workers/static-assets/routing/worker-script/
  // Must match the Worker name in the Cloudflare dashboard exactly. Workers Builds
  // hard-fails the build on a mismatch rather than warning, so never change one
  // without the other in the same commit.
  "name": "yveskwameh",
  "compatibility_date": "2026-09-06",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve /404.html when a path is not found. Only honoured because worker/index.ts
    // hands unmatched requests back to this binding; a Worker that answers them itself
    // never lets this line do anything.
    "not_found_handling": "404-page",
    // The Worker sees every request before the assets do. Needed for the workers.dev to
    // apex redirect in worker/index.ts, which otherwise could not catch a path that
    // matches a real file. Costs an invocation per request, which on a site this size is
    // the cheaper half of the trade against two hosts competing in search.
    "run_worker_first": true
  },
  // One Durable Object, holding whoever has the site open. Free on the Workers free plan,
  // and the hibernation API in worker/index.ts means an idle room costs nothing.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // SQLite-backed, which is what makes Durable Objects available without a paid plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  // Written by the Cloudflare dashboard, so keep it as it is or the next dashboard change
  // will fight this file. Invocation logs on, traces off.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
